 #ifdef CONFIG_PDJ_VENDOR_SPEC
+static int append_acm_descriptors(struct usb_composite_dev *cdev,
+		unsigned base_length, enum usb_device_speed speed)
+{
+	struct usb_configuration *config;
+	struct usb_function *function;
+	struct usb_config_descriptor *descriptor = cdev->req->buf;
+	int length = base_length;
+
+	if (list_empty(&cdev->configs))
+		return -EINVAL;
+	config = list_first_entry(&cdev->configs, struct usb_configuration, list);
+
+	list_for_each_entry(function, &config->functions, list) {
+		struct usb_descriptor_header **descriptors;
+		int status;
+
+		if (strcmp(function->name, "acm"))
+			continue;
+		descriptors = speed == USB_SPEED_HIGH
+			? function->hs_descriptors : function->descriptors;
+		status = usb_descriptor_fillbuf(cdev->req->buf + length,
+				USB_BUFSIZ - length,
+				(const struct usb_descriptor_header **)descriptors);
+		if (status < 0)
+			return status;
+		length += status;
+	}
+
+	descriptor->bNumInterfaces = config->next_interface_id;
+	descriptor->wTotalLength = cpu_to_le16(length);
+	return length;
+}
